AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=finops
CLICKHOUSE_DB=finops
CLICKHOUSE_CONNECT_TIMEOUT=2
CLICKHOUSE_SEND_RECEIVE_TIMEOUT=5

CORS_ORIGINS=http://localhost:3000

# Agente FinOps (F1). Sem chave, o agente fica desligado e o chat responde 503.
# Em producao, injete a chave via AWS Secrets Manager na task definition.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
AGENT_DAILY_TOKEN_BUDGET=2000000
AGENT_MAX_CONCURRENCY=4
AGENT_MAX_ITERATIONS=6
AGENT_DEADLINE_SECONDS=100
# Timeout do proxy na API; deve ser maior que AGENT_DEADLINE_SECONDS.
AGENT_TIMEOUT_SECONDS=130
